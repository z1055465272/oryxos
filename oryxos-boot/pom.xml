<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.oryxos</groupId>
        <artifactId>oryxos</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>oryxos-boot</artifactId>
    <name>oryxos-boot</name>
    <description>支撑：Spring Boot 启动模块，把全部分支打成 fat JAR（单二进制部署）</description>

    <dependencies>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-tool</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-channel-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 工程地基：Actuator + Micrometer + Prometheus 监控 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- 工程地基：生产环境结构化 JSON 日志（LogstashEncoder） -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- CLI 是整个 OryxOS 的入口：java -jar 分发到子命令；serve 子命令内部再启动 Spring -->
                    <mainClass>com.oryxos.cli.OryxOscCli</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
